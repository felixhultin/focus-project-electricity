[["2013-01-01",0,"Han skall begrafva den till skaftet i ","trollpackans"," hufvud .","https://litteraturbanken.se/författare/LagerlöfS/titlar/GöstaBerlingsSaga1SLA/sida/48/etext?query=trollpacka"],["2013-01-01",0,"Skogen är full af oheliga djur , besatta af onda ","trollpackors"," och mordlystna skojares själar .","https://litteraturbanken.se/författare/LagerlöfS/titlar/GöstaBerlingsSaga1SLA/sida/140/etext?query=trollpacka"],["2013-01-01",0,"En häxa och ","trollpacka"," var hon för alla dessa , som hon tjänat , som hon gett arbete och bröd .","https://litteraturbanken.se/författare/LagerlöfS/titlar/GöstaBerlingsSaga2SLA/sida/283/etext?query=trollpacka"],["2013-01-01",0,"En häxa är jag , en ","trollpacka"," är jag , till ondt skall jag hetsa er .","https://litteraturbanken.se/författare/LagerlöfS/titlar/GöstaBerlingsSaga2SLA/sida/291/etext?query=trollpacka"],["2017-01-01",0,"…av planscher , föreställande stolta furstinnor , präktiga kungar , ädla riddare , strålande feer , avskyvärda ","trollpackor"," , underbara sagoslott .","https://litteraturbanken.se/författare/HelgesonP/titlar/Julklappsboken/sida/80/etext?query=trollpacka"],["2019-01-01",0,"Han ska begrava den till skaftet i ","trollpackans"," huvud .","https://litteraturbanken.se/författare/AlfredsonC/titlar/DåIVårtMörkaHus/sida/60/etext?query=trollpacka"]]