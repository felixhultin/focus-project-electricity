[["1753-01-01",0,"sitt fel hon på sin ","maka"," skyller .","https://litteraturbanken.se/författare/Tankebyggarorden/titlar/VåraFörsök1/sida/35/etext?query=maka"],["1756-01-01",0,"Nu i gråt vår skönhet brast , Skall jag ingen ","maka"," välja ?","https://litteraturbanken.se/författare/Tankebyggarorden/titlar/VåraFörsök3/sida/115/etext?query=maka"],["1756-01-01",0,"Din like sök till vän , till sälskap och till ","maka"," Om du af dem vill frid och nöje smaka .","https://litteraturbanken.se/författare/Tankebyggarorden/titlar/VåraFörsök3/sida/119/etext?query=maka"]]