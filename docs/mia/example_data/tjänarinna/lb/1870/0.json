[["1878-01-01",0,"Hon skulle vara mannens och ofta hela familjens ","tjänarinna"," .","https://litteraturbanken.se/författare/LundinC/titlar/OxygenAromasia/sida/26/etext?query=tj%C3%A4narinna"],["1879-01-01",0,"Hon gret länge vid den trogna ","tjänarinnans"," bröst .","https://litteraturbanken.se/författare/LundinC/titlar/GamlaKort/sida/215/faksimil?query=tj%C3%A4narinna"],["1879-01-01",0,"Den gamla ","tjänarinnan"," kunde ej mera gå ut .","https://litteraturbanken.se/författare/LundinC/titlar/GamlaKort/sida/229/faksimil?query=tj%C3%A4narinna"],["1876-01-01",0,"…ma artigheter hvilka ej taga sig illa ut i Andalu sien från en castilianares läppar , visade sig en af husets ","tjänarinnor"," , den rundhöftade Pepa , och tvekade ej att störa prestmannens lugn .","https://litteraturbanken.se/författare/LundinC/titlar/ValdaBerättelser1/sida/30/faksimil?query=tj%C3%A4narinna"]]