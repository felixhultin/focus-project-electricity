[["1946-01-01",0,"Men har några för ","kvinnokönet"," uppfunna spenamn kommit ur bruk ?","https://litteraturbanken.se/författare/JohansonK/titlar/DetRikaStärbhuset/sida/223/faksimil?query=kvinnok%C3%B6n"],["1946-01-01",0,"… upp denna söla de antikvitet ur avskrädeshögen och sammansvurit sig att lansera den som favoritbeteckning på ","kvinnokönet"," i gemen , deras egna personer inberäknade .","https://litteraturbanken.se/författare/JohansonK/titlar/DetRikaStärbhuset/sida/223/faksimil?query=kvinnok%C3%B6n"],["1942-01-01",0,"Och han ställer sig en garde mot ","kvinnokönet"," .","https://litteraturbanken.se/författare/LindbergP/titlar/GöstaEkman/sida/200/faksimil?query=kvinnok%C3%B6n"],["1945-01-01",0,"Det som förmenas ","kvinnokönet"," trots dess naturliga höghet , kräves ännu ibland för vissa yrken .","https://litteraturbanken.se/författare/SegerstedtTorgny/titlar/IDag/sida/45/faksimil?query=kvinnok%C3%B6n"],["1942-01-01",0,"Men med Kristina skapar han ju ett helt drama om en dylik avart av ","kvinnokönet"," .","https://litteraturbanken.se/författare/LammM/titlar/AugustStrindberg2/sida/120/faksimil?query=kvinnok%C3%B6n"]]